generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MessageStatus {
  PENDING
  COMPLETE
  ERROR
  CANCELLED
}

enum GenerationRunType {
  PERSONA_DRAFT
  PERSONA_AVATAR
}

enum GenerationRunStatus {
  PENDING
  COMPLETE
  ERROR
  CANCELLED
}

enum MemoryScope {
  GLOBAL
  PERSONA
}

enum MemoryOrigin {
  MANUAL
  CHAT_MESSAGE
  AUTO_EXTRACTED
}

enum MemoryVerificationMethod {
  MANUAL_ENTRY
  EXPLICIT_REQUEST
  PROPOSAL_ACCEPTANCE
  MANUAL_REVIEW
  LEGACY_UNREVIEWED
}

enum MemoryProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum MemoryProposalAction {
  CREATE
  UPDATE
}

enum ToolType {
  SUMMARIZE
  REWRITE
  TRANSLATE
  IMAGE_ANALYZE
  IMAGE_GENERATE
  BRAINSTORM
}

enum BrainstormWorkerRole {
  ANALYST
  CREATIVE
  CRITIC
  PLANNER
}

enum BrainstormWorkerStatus {
  PENDING
  COMPLETE
  ERROR
  CANCELLED
}

enum AgentRunMode {
  STANDARD
  DEEP
}

enum AgentRunStatus {
  PENDING
  COMPLETE
  ERROR
  CANCELLED
}

enum AgentRunPhase {
  PLANNING
  DISPATCHING
  WORKING
  SYNTHESIZING
  FINISHED
}

enum AgentWorkerStatus {
  QUEUED
  BLOCKED
  RUNNING
  COMPLETE
  ERROR
  CANCELLED
  TIMEOUT
}

enum AgentPriority {
  HIGH
  MEDIUM
  LOW
}

enum AgentEventType {
  RUN_CREATED
  PLANNING_STARTED
  PLAN_CREATED
  PLAN_FALLBACK
  WORKERS_CREATED
  WORKER_QUEUED
  WORKER_BLOCKED
  WORKER_STARTED
  WORKER_COMPLETED
  WORKER_FAILED
  WORKER_CANCELLED
  WORKER_TIMEOUT
  SYNTHESIS_STARTED
  RUN_COMPLETED
  RUN_FAILED
  RUN_CANCELLED
  RUN_TIMEOUT
}

enum GeneratedImageKind {
  PERSONA_AVATAR
  TOOL_GENERATION
}

enum ToolAssetKind {
  IMAGE
}

enum ToolRunStatus {
  PENDING
  COMPLETE
  ERROR
  CANCELLED
}

enum UsageCapability {
  CHAT_MESSAGE
  TOOL_SUMMARIZE
  TOOL_REWRITE
  TOOL_TRANSLATE
  IMAGE_ANALYZE
  IMAGE_GENERATE
  BRAINSTORM
  AGENT_STANDARD
  AGENT_DEEP
}

model Profile {
  id            String   @id @db.Uuid
  email         String   @unique
  displayName   String?  @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  role          Role     @default(USER)
  memoryEnabled Boolean  @default(true) @map("memory_enabled")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  personas          Persona[]
  conversations     Conversation[]
  memories          Memory[]
  memoryProposals   MemoryProposal[]
  memoryEmbeddings  MemoryEmbedding[]
  images            GeneratedImage[]
  toolRuns          ToolRun[]
  toolAssets        ToolAsset[]
  generationRuns    GenerationRun[]
  brainstormWorkers BrainstormWorker[]
  agentRuns         AgentRun[]
  agentWorkers      AgentWorker[]
  agentEvents       AgentEvent[]
  usageLedger       UsageLedger[]

  ownedProjects Project[]
  updatedProjectDrafts ProjectDraft[]
  submittedPublicationReviews PublicationReview[] @relation("ReviewSubmitter")
  reviewedPublicationReviews PublicationReview[] @relation("ReviewReviewer")
  projectMemberships ProjectMembership[]
  @@map("profiles")
}

model UsageLedger {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  capability     UsageCapability
  units          Int             @default(1)
  runId          String          @map("run_id") @db.Uuid
  idempotencyKey String          @map("idempotency_key") @db.VarChar(200)
  provider       String?         @db.VarChar(100)
  model          String?         @db.VarChar(200)
  inputTokens    Int?            @map("input_tokens")
  outputTokens   Int?            @map("output_tokens")
  estimatedCost  Decimal?        @map("estimated_cost") @db.Decimal(18, 8)
  pricingVersion String?         @map("pricing_version") @db.VarChar(50)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, runId])
  @@unique([userId, idempotencyKey])
  @@index([userId, capability, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("usage_ledger")
}

model ToolRun {
  storageDeletionRequestedAt DateTime? @map("storage_deletion_requested_at") @db.Timestamptz(6)
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  type              ToolType
  status            ToolRunStatus @default(PENDING)
  title             String?       @db.VarChar(100)
  inputText         String?       @map("input_text") @db.Text
  outputText        String?       @map("output_text") @db.Text
  options           Json
  retainContent     Boolean       @default(true) @map("retain_content")
  errorCode         String?       @map("error_code") @db.VarChar(100)
  recoveryExpiresAt DateTime?     @map("recovery_expires_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets            ToolAsset[]
  generatedImage    GeneratedImage?
  brainstormWorkers BrainstormWorker[]

  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("tool_runs")
}

model BrainstormWorker {
  id          String                 @id @default(uuid()) @db.Uuid
  toolRunId   String                 @map("tool_run_id") @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  role        BrainstormWorkerRole
  position    Int
  status      BrainstormWorkerStatus @default(PENDING)
  outputText  String?                @map("output_text") @db.Text
  errorCode   String?                @map("error_code") @db.VarChar(100)
  startedAt   DateTime?              @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  toolRun ToolRun @relation(fields: [toolRunId, userId], references: [id, userId], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolRunId, role])
  @@unique([toolRunId, position])
  @@index([userId, createdAt(sort: Desc)])
  @@index([toolRunId, status])
  @@map("brainstorm_workers")
}

model GenerationRun {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  personaId String?             @map("persona_id") @db.Uuid
  type      GenerationRunType
  status    GenerationRunStatus @default(PENDING)
  input     Json
  result    Json?
  errorCode String?             @map("error_code") @db.VarChar(100)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([personaId, type, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("generation_runs")
}

model ToolAsset {
  storageBucket String? @map("storage_bucket")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  toolRunId   String        @map("tool_run_id") @db.Uuid
  kind        ToolAssetKind @default(IMAGE)
  storagePath String        @map("storage_path")
  mimeType    String        @map("mime_type") @db.VarChar(100)
  sizeBytes   Int           @map("size_bytes")
  width       Int
  height      Int
  sha256      String        @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolRun ToolRun @relation(fields: [toolRunId], references: [id], onDelete: Cascade)

  @@unique([toolRunId])
  @@index([userId, expiresAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("tool_assets")
}

model Persona {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  avatarUrl     String?   @map("avatar_url")
  avatarPrompt  String?   @map("avatar_prompt")
  avatarImageId String?   @unique @map("avatar_image_id") @db.Uuid
  description   String?
  personality   String
  identity      String?
  speakingStyle String?   @map("speaking_style")
  expertise     String?
  greeting      String?
  systemPrompt  String    @map("system_prompt")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  memories        Memory[]
  memoryProposals MemoryProposal[]
  avatarImage     GeneratedImage?  @relation("PersonaAvatarImage", fields: [avatarImageId], references: [id], onDelete: SetNull)
  generationRuns  GenerationRun[]

  @@unique([id, userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, archivedAt, updatedAt(sort: Desc)])
  @@map("personas")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  personaId String?  @map("persona_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona         Persona?         @relation(fields: [personaId], references: [id], onDelete: SetNull)
  messages        Message[]
  memories        Memory[]
  memoryProposals MemoryProposal[]
  agentRuns       AgentRun[]

  @@unique([id, userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  status         MessageStatus @default(COMPLETE)
  provider       String?
  model          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt   DateTime?     @map("superseded_at") @db.Timestamptz(6)

  conversation          Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMemories        Memory[]         @relation("MemorySourceMessage")
  sourceMemoryProposals MemoryProposal[] @relation("MemoryProposalSourceMessage")
  agentRunAsUser        AgentRun?        @relation("AgentRunUserMessage")
  agentRunAsAssistant   AgentRun?        @relation("AgentRunAssistantMessage")

  @@unique([id, conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, supersededAt, createdAt])
  @@map("messages")
}

model AgentRun {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  conversationId        String         @map("conversation_id") @db.Uuid
  userMessageId         String         @map("user_message_id") @db.Uuid
  assistantMessageId    String         @map("assistant_message_id") @db.Uuid
  mode                  AgentRunMode
  status                AgentRunStatus @default(PENDING)
  phase                 AgentRunPhase  @default(PLANNING)
  planOverview          String?        @map("plan_overview") @db.Text
  planFallback          Boolean        @default(false) @map("plan_fallback")
  plannedWorkerCount    Int            @map("planned_worker_count")
  completedWorkerCount  Int            @default(0) @map("completed_worker_count")
  successfulWorkerCount Int            @default(0) @map("successful_worker_count")
  providerCallCount     Int            @default(0) @map("provider_call_count")
  errorCode             String?        @map("error_code") @db.VarChar(100)
  startedAt             DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     Conversation  @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)
  userMessage      Message       @relation("AgentRunUserMessage", fields: [userMessageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  assistantMessage Message       @relation("AgentRunAssistantMessage", fields: [assistantMessageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  workers          AgentWorker[]
  events           AgentEvent[]

  @@unique([id, userId])
  @@unique([userMessageId, conversationId])
  @@unique([assistantMessageId, conversationId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, mode, status, createdAt(sort: Desc)])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

model AgentWorker {
  id                  String            @id @default(uuid()) @db.Uuid
  agentRunId          String            @map("agent_run_id") @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  key                 String            @db.VarChar(64)
  position            Int
  name                String            @db.VarChar(80)
  title               String            @db.VarChar(160)
  objective           String            @db.VarChar(1200)
  expectedDeliverable String            @map("expected_deliverable") @db.VarChar(1200)
  priority            AgentPriority
  status              AgentWorkerStatus @default(QUEUED)
  dependsOnKeys       String[]          @default([]) @map("depends_on_keys")
  workSummary         String?           @map("work_summary") @db.VarChar(1200)
  findings            String[]          @default([])
  assumptions         String[]          @default([])
  risks               String[]          @default([])
  recommendations     String[]          @default([])
  finalDeliverable    String?           @map("final_deliverable") @db.Text
  structured          Boolean           @default(false)
  providerCallCount   Int               @default(0) @map("provider_call_count")
  errorCode           String?           @map("error_code") @db.VarChar(100)
  startedAt           DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentRun AgentRun @relation(fields: [agentRunId, userId], references: [id, userId], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, key])
  @@unique([agentRunId, position])
  @@index([userId, createdAt(sort: Desc)])
  @@index([agentRunId, status])
  @@map("agent_workers")
}

model AgentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  agentRunId  String         @map("agent_run_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  sequence    Int
  type        AgentEventType
  workerKey   String?        @map("worker_key") @db.VarChar(64)
  summaryText String?        @map("summary_text") @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  agentRun AgentRun @relation(fields: [agentRunId, userId], references: [id, userId], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, sequence])
  @@index([userId, createdAt(sort: Desc)])
  @@index([agentRunId, type, createdAt])
  @@map("agent_events")
}

model Memory {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  personaId            String?      @map("persona_id") @db.Uuid
  content              String
  category             String
  scope                MemoryScope  @default(GLOBAL)
  origin               MemoryOrigin @default(MANUAL)
  verificationMethod   MemoryVerificationMethod @map("verification_method")
  verifiedAt           DateTime?    @map("verified_at") @db.Timestamptz(6)
  importance           Int          @default(3)
  sourceConversationId String?      @map("source_conversation_id") @db.Uuid
  sourceMessageId      String?      @map("source_message_id") @db.Uuid
  enabled              Boolean      @default(true)
  lastUsedAt           DateTime?    @map("last_used_at") @db.Timestamptz(6)
  topicKey             String?      @map("topic_key")
  keywords             String[]     @default([])
  pinned               Boolean      @default(false)
  useCount             Int          @default(0) @map("use_count")
  revision             Int          @default(1)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona            Persona?         @relation(fields: [personaId], references: [id], onDelete: Cascade)
  sourceConversation Conversation?    @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage      Message?         @relation("MemorySourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  embedding          MemoryEmbedding?
  targetedProposals  MemoryProposal[] @relation("MemoryProposalTarget")
  resolvedProposals  MemoryProposal[] @relation("MemoryProposalResolved")

  @@unique([id, userId])
  @@index([userId, enabled, scope, importance, updatedAt(sort: Desc)])
  @@index([personaId, enabled, importance])
  @@index([sourceMessageId])
  @@index([userId, pinned, enabled, importance])
  @@index([userId, verificationMethod, updatedAt(sort: Desc)])
  @@index([userId, topicKey])
  @@index([personaId, topicKey])
  @@map("memories")
}

model MemoryProposal {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  personaId             String?              @map("persona_id") @db.Uuid
  action                MemoryProposalAction
  status                MemoryProposalStatus @default(PENDING)
  targetMemoryId        String?              @map("target_memory_id") @db.Uuid
  targetMemoryUpdatedAt DateTime?            @map("target_memory_updated_at") @db.Timestamptz(6)
  targetMemoryRevision  Int?                 @map("target_memory_revision")
  resolvedMemoryId      String?              @map("resolved_memory_id") @db.Uuid
  content               String
  category              String
  scope                 MemoryScope
  importance            Int                  @default(3)
  topicKey              String?              @map("topic_key")
  keywords              String[]             @default([])
  confidence            Float
  reasonCode            String               @map("reason_code")
  sourceConversationId  String?              @map("source_conversation_id") @db.Uuid
  sourceMessageId       String?              @map("source_message_id") @db.Uuid
  dedupeKey             String               @map("dedupe_key") @db.VarChar(64)
  suppressionKey        String               @map("suppression_key") @db.VarChar(64)
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz(6)
  resolvedAt            DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona            Persona?      @relation(fields: [personaId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  targetMemory       Memory?       @relation("MemoryProposalTarget", fields: [targetMemoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: Restrict)
  resolvedMemory     Memory?       @relation("MemoryProposalResolved", fields: [resolvedMemoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: Restrict)
  sourceConversation Conversation? @relation(fields: [sourceConversationId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  sourceMessage      Message?      @relation("MemoryProposalSourceMessage", fields: [sourceMessageId, sourceConversationId], references: [id, conversationId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([sourceMessageId])
  @@index([targetMemoryId])
  @@index([userId, suppressionKey, status, resolvedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("memory_proposals")
}

model MemoryEmbedding {
  memoryId    String                     @id @map("memory_id") @db.Uuid
  userId      String                     @map("user_id") @db.Uuid
  model       String
  dimensions  Int
  contentHash String                     @map("content_hash")
  embedding   Unsupported("vector(512)")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memory Memory  @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, model, dimensions])
  @@map("memory_embeddings")
}

model GeneratedImage {
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz(6)
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  kind          GeneratedImageKind @default(PERSONA_AVATAR)
  prompt        String
  provider      String
  model         String
  storagePath   String             @map("storage_path")
  storageBucket String             @default("persona-avatars") @map("storage_bucket") @db.VarChar(100)
  mimeType      String?            @map("mime_type") @db.VarChar(100)
  sizeBytes     Int?               @map("size_bytes")
  width         Int?
  height        Int?
  toolRunId     String?            @unique @map("tool_run_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaAvatar Persona? @relation("PersonaAvatarImage")
  toolRun       ToolRun? @relation(fields: [toolRunId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([toolRunId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("generated_images")
}

model AssetDeletion {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  resourceId String @map("resource_id") @db.Uuid
  scopeId String? @map("scope_id") @db.Uuid
  kind String
  bucket String
  path String
  state String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode String? @map("last_error_code")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([bucket, path])
  @@index([state, nextAttemptAt])
  @@map("asset_deletions")
}

model ModelConfig {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String
  model        String
  capabilities String[]
  enabled      Boolean  @default(true)
  parameters   Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, model])
  @@map("model_configs")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
// Registry is additive. SQL-only checks, partial indexes and guards are documented
// in docs/registry-foundation.md and enforced by the ordered migration.
enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}
enum ProjectDraftState {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}
enum ProjectReleaseState {
  PUBLISHED
  WITHDRAWN
}
enum ProjectAssetState {
  QUARANTINED
  VALIDATED
  APPROVED
  RETIRED
  REJECTED
}
enum ProjectRole {
  OWNER
  EDITOR
  REVIEWER
  PUBLISHER
  VIEWER
}
enum PublicationDecision {
  PENDING
  APPROVED
  REJECTED
  INVALIDATED
}
model Project {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(63)
  ownerId String @map("owner_id") @db.Uuid
  visibility ProjectVisibility @default(PRIVATE)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  currentReleaseId String? @map("current_release_id") @db.Uuid
  authzEpoch Int @default(1) @map("authz_epoch")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentRelease ProjectRelease? @relation("CurrentRelease", fields: [currentReleaseId, id], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  drafts ProjectDraft[]
  versions ProjectVersion[]
  releases ProjectRelease[] @relation("ProjectReleases")
  assets ProjectAsset[]
  documentation ProjectDocumentation[]
  memberships ProjectMembership[]
  reviews PublicationReview[]
  @@map("projects")
}
model ProjectDraft {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  revision Int @default(1)
  state ProjectDraftState @default(DRAFT)
  manifest Json @default("{}")
  presentation Json @default("{}")
  documentation Json @default("[]")
  updatedBy String @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updater Profile @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documents ProjectDocumentation[]
  reviews PublicationReview[]
  @@unique([id, projectId])
  @@index([projectId, state])
  @@map("project_drafts")
}
model PublicationReview {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  draftId String @map("draft_id") @db.Uuid
  draftRevision Int @map("draft_revision")
  authzEpoch Int @map("authz_epoch")
  snapshotHash String @map("snapshot_hash") @db.VarChar(64)
  visibility ProjectVisibility
  assetDigestSet Json @map("asset_digest_set")
  submitterId String @map("submitter_id") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid
  decision PublicationDecision @default(PENDING)
  policyRevision Int @map("policy_revision")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  draft ProjectDraft @relation(fields: [draftId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  submitter Profile @relation("ReviewSubmitter", fields: [submitterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer Profile? @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions ProjectVersion[]
  @@unique([id, projectId])
  @@index([projectId, decision])
  @@map("publication_reviews")
}
model ProjectVersion {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  version String @db.VarChar(100)
  snapshot Json
  contentHash String @map("content_hash") @db.VarChar(64)
  hashAlgorithm String @default("JCS-SHA256-v1") @map("hash_algorithm") @db.VarChar(32)
  reviewId String @map("review_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  review PublicationReview @relation(fields: [reviewId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  releases ProjectRelease[]
  documents ProjectDocumentation[]
  @@unique([projectId, version])
  @@unique([id, projectId])
  @@map("project_versions")
}
model ProjectRelease {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid
  visibilityAtApproval ProjectVisibility @map("visibility_at_approval")
  contentHash String @map("content_hash") @db.VarChar(64)
  state ProjectReleaseState @default(PUBLISHED)
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  project Project @relation("ProjectReleases", fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version ProjectVersion @relation(fields: [versionId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  currentFor Project[] @relation("CurrentRelease")
  @@unique([id, projectId])
  @@index([projectId, state])
  @@map("project_releases")
}
model ProjectAsset {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  sourceDigest String @map("source_digest") @db.VarChar(64)
  deliveryDigest String? @map("delivery_digest") @db.VarChar(64)
  mime String @db.VarChar(100)
  size Int
  dataClass String @map("data_class") @db.VarChar(100)
  storageRef String @unique @map("storage_ref")
  provenance Json
  rightsRef String @map("rights_ref")
  scanRevision Int @default(1) @map("scan_revision")
  state ProjectAssetState @default(QUARANTINED)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  documents ProjectDocumentation[]
  @@unique([id, projectId])
  @@index([projectId, state])
  @@map("project_assets")
}
model ProjectDocumentation {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  draftId String? @map("draft_id") @db.Uuid
  versionId String? @map("version_id") @db.Uuid
  title String @db.VarChar(500)
  language String @db.VarChar(2)
  assetId String @map("asset_id") @db.Uuid
  contentHash String @map("content_hash") @db.VarChar(64)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  draft ProjectDraft? @relation(fields: [draftId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  version ProjectVersion? @relation(fields: [versionId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  asset ProjectAsset @relation(fields: [assetId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)
  @@index([projectId])
  @@map("project_documentation")
}
model ProjectMembership {
  projectId String @map("project_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  roles ProjectRole[]
  active Boolean @default(true)
  revision Int @default(1)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subject Profile @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([projectId, subjectId])
  @@index([subjectId, active])
  @@map("project_memberships")
}
