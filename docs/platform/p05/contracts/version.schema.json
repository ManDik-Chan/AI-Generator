{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aig:p05:version:0.5.0",
  "$ref": "#/$defs/Version",
  "$defs": {
    "Version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "snapshot": {
          "$ref": "#/$defs/DraftPayload"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hashAlgorithm": {
          "const": "JCS-SHA256-v1"
        },
        "reviewId": {
          "type": "string",
          "format": "uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "projectId",
        "version",
        "snapshot",
        "contentHash",
        "hashAlgorithm",
        "reviewId",
        "createdAt"
      ]
    },
    "DraftPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "#/$defs/Manifest"
        },
        "presentation": {
          "$ref": "#/$defs/Presentation"
        },
        "documentation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Documentation"
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "manifest",
        "presentation",
        "documentation"
      ]
    },
    "Documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "enum": [
            "zh",
            "en"
          ]
        },
        "assetId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "assetId"
      ]
    },
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.5.0"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          },
          "minItems": 0,
          "maxItems": 24,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "version",
        "title",
        "sections"
      ]
    },
    "Section": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "kind": {
              "const": "MARKDOWN"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "maxLength": 20000
            },
            "sourceAssetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "body",
            "sourceAssetIds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "kind": {
              "const": "IMAGE"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "assetId": {
              "type": "string",
              "format": "uuid"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "assetId",
            "alt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "kind": {
              "const": "BENCHMARKS"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "metrics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Metric"
              },
              "minItems": 0,
              "maxItems": 30,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "metrics"
          ]
        }
      ]
    },
    "Metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "status": {
              "const": "UNPUBLISHED"
            }
          },
          "required": [
            "name",
            "status"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "status": {
              "const": "REPORTED"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "dataset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "modelVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "evidenceAssetId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "name",
            "status",
            "value",
            "unit",
            "dataset",
            "protocol",
            "modelVersion",
            "evidenceAssetId"
          ]
        }
      ]
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.5.0"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "enum": [
            "research",
            "software",
            "algorithm",
            "web-service",
            "ai",
            "other"
          ]
        },
        "visibility": {
          "enum": [
            "PRIVATE",
            "UNLISTED",
            "PUBLIC"
          ]
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "SHOWCASE"
            }
          },
          "required": [
            "mode"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "documentation.read",
              "presentation.read",
              "static-image.read"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "researchClaims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 0,
          "maxItems": 40,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "slug",
        "version",
        "name",
        "summary",
        "category",
        "visibility",
        "integration",
        "capabilities",
        "researchClaims"
      ]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "SOURCE_IMPLEMENTED",
            "DOCUMENTED",
            "EXPERIMENT_VERIFIED",
            "PLANNED"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidenceAssetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "topic",
        "status",
        "description",
        "evidenceAssetIds"
      ]
    }
  }
}
