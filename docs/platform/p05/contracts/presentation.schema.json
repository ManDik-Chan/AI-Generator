{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aig:p05:presentation:0.5.0",
  "$ref": "#/$defs/Presentation",
  "$defs": {
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.5.0"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          },
          "minItems": 0,
          "maxItems": 24,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "version",
        "title",
        "sections"
      ]
    },
    "Section": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "kind": {
              "const": "MARKDOWN"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "body": {
              "type": "string",
              "maxLength": 20000
            },
            "sourceAssetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 0,
              "maxItems": 100,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "body",
            "sourceAssetIds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "kind": {
              "const": "IMAGE"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "assetId": {
              "type": "string",
              "format": "uuid"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "assetId",
            "alt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "kind": {
              "const": "BENCHMARKS"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "metrics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Metric"
              },
              "minItems": 0,
              "maxItems": 30,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "title",
            "metrics"
          ]
        }
      ]
    },
    "Metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "status": {
              "const": "UNPUBLISHED"
            }
          },
          "required": [
            "name",
            "status"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "status": {
              "const": "REPORTED"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "dataset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "protocol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "modelVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "evidenceAssetId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "name",
            "status",
            "value",
            "unit",
            "dataset",
            "protocol",
            "modelVersion",
            "evidenceAssetId"
          ]
        }
      ]
    }
  }
}
